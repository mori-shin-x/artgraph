{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!**/node_modules/**"
  ],
  "specDirs": [
    "specs",
    "docs"
  ],
  "testPatterns": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.tsx",
    "!**/node_modules/**",
    "!tests/fixtures/**",
    "!examples/**"
  ],
  "lockFile": ".trace.lock",
  "packageManager": "pnpm"
}
